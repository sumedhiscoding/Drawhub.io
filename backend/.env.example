# Backend Environment Variables
# Copy this file to .env and update with your actual values

# Server Configuration
# Port number for the server to listen on
# Default: 4000
PORT=4000

# Frontend URL - Used for CORS configuration
# Set this to your frontend URL to allow cross-origin requests
# For production, set this to your deployed frontend URL (e.g., https://yourdomain.com)
# For development, this is typically http://localhost:5173 (Vite default)
FRONTEND_URL=http://localhost:5173

# Database Configuration
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
# Example: postgresql://user:password@localhost:5432/whiteboard_db
DATABASE_URL=postgresql://user:password@localhost:5432/whiteboard_db

# JWT Secret - Used for signing and verifying JWT tokens
# IMPORTANT: Use a strong, random secret in production!
# Generate a secure secret: openssl rand -base64 32
# Never commit the actual secret to version control
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Node Environment
# Set to 'production' for production deployments
# Set to 'development' for local development
NODE_ENV=development
